rules_version = '2';

// ═══════════════════════════════════════════════════════════
// 🗄️ STORAGE — reglas de MusicTrack (v0.15.0)
// Pegalas en: Firebase Console → Storage → Reglas
// Estructura que protege:
//   musictrack/{uid}/{idCancion}  → los MP3 respaldados
// Regla de oro: SOLO el dueño del uid lee y escribe sus MP3.
// ═══════════════════════════════════════════════════════════

service firebase.storage {
  match /b/{bucket}/o {
    match /musictrack/{uid}/{archivo=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
